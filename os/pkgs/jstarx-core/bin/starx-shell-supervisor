#!/usr/bin/env bash
# Keeps StarShell running. If it crashes 3 times in a row, ask the system to repair JStarx
# (undo the last update, or go back to the factory version), then try again. Last resort: Safe Mode.
RUN="${XDG_RUNTIME_DIR:-/tmp}/jstarx"; mkdir -p "$RUN"
LOG="$RUN/supervisor.log"
FACTORY="$(readlink -f /etc/jstarx/factory-layer)"
fails=0
while true; do
  start=$(date +%s)
  "$JSTARX_LAYER/bin/starx-shell"
  code=$?
  [ "$code" -eq 0 ] && exit 0
  dur=$(( $(date +%s) - start ))
  if [ "$dur" -lt 90 ]; then fails=$((fails + 1)); else fails=1; fi
  echo "$(date) StarShell stopped (code $code after ${dur}s), failures in a row: $fails" >>"$LOG"
  if [ "$fails" -ge 3 ]; then
    PYTHONPATH="$FACTORY" "${STARX_PYTHON:-python3}" -c 'from starx import daemon; print(daemon.starxd("shell_failed", timeout=120))' >>"$LOG" 2>&1
    NEW="$(readlink -f /var/lib/jstarx/layers/current 2>/dev/null)"
    if [ -n "$NEW" ] && [ "$NEW" != "$JSTARX_LAYER" ] && [ -f "$NEW/layer.json" ]; then
      echo "$(date) auto-repair switched to $NEW" >>"$LOG"
      export JSTARX_LAYER="$NEW"
    else
      echo "$(date) starting Safe Mode (factory layer)" >>"$LOG"
      export JSTARX_LAYER="$FACTORY" STARX_SAFE_MODE=1
    fi
    export STARX_APP_BIN="$JSTARX_LAYER/bin/starx-app" PATH="$JSTARX_LAYER/bin:$PATH"
    fails=0
  fi
  sleep 1
done
