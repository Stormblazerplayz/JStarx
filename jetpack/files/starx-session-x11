#!/usr/bin/env bash
# The JStarx desktop on JetPack (X11): the openbox window manager, xcompmgr (for the see-through
# corners of the Dynamic Island) and the StarShell supervisor. Pick "JStarx" at the login screen.
set -u
export XDG_CURRENT_DESKTOP=JStarx XDG_SESSION_DESKTOP=JStarx XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11 MOZ_ENABLE_WAYLAND=0 MOZ_LEGACY_PROFILES=1 STARX_GPU=never
export GTK_THEME="${GTK_THEME:-JStarx}"  # the purple JStarx theme for GTK windows (installed by install.sh)
export STARX_PYTHON="${STARX_PYTHON:-/usr/bin/python3}"

# The active JStarx layer, with the same rules as on the SD card (an update applies at the next start)
if [ -z "${JSTARX_LAYER:-}" ] || [ ! -f "$JSTARX_LAYER/layer.json" ]; then
  JSTARX_LAYER="$(readlink -f /var/lib/jstarx/layers/current 2>/dev/null)"
fi
if [ ! -f "${JSTARX_LAYER:-/nonexistent}/layer.json" ]; then
  JSTARX_LAYER="$(readlink -f /etc/jstarx/factory-layer)"
fi
export JSTARX_LAYER STARX_APP_BIN="$JSTARX_LAYER/bin/starx-app"
export PATH="$JSTARX_LAYER/bin:/opt/jstarx/bin:$PATH"

# Firefox: one profile, with the JStarx top bar that curves around the Dynamic Island
FFDIR="$HOME/.mozilla/firefox"
if [ ! -f "$FFDIR/profiles.ini" ]; then
  mkdir -p "$FFDIR/jstarx.default"
  printf '[General]\nStartWithLastProfile=1\nVersion=2\n\n[Profile0]\nName=default\nIsRelative=1\nPath=jstarx.default\nDefault=1\n' > "$FFDIR/profiles.ini"
fi
FFPROFILE="$(sed -n 's/^Path=//p' "$FFDIR/profiles.ini" | head -n 1)"
if [ -n "$FFPROFILE" ]; then
  case "$FFPROFILE" in /*) ;; *) FFPROFILE="$FFDIR/$FFPROFILE" ;; esac
  mkdir -p "$FFPROFILE/chrome"
  # keep a userChrome.css the user made themselves; otherwise follow the active JStarx layer
  if [ ! -e "$FFPROFILE/chrome/userChrome.css" ] || [ -L "$FFPROFILE/chrome/userChrome.css" ]; then
    ln -sfn "$JSTARX_LAYER/assets/firefox/userChrome.css" "$FFPROFILE/chrome/userChrome.css"
  fi
fi

# The screen: X does not blank it by itself. StarShell turns it off after the time set in Settings.
xset s off || true
xset -dpms || true

# Transparency for the Dynamic Island's see-through corners
xcompmgr >/dev/null 2>&1 &

# The window manager runs the session. When it exits, the session ends. StarShell starts once
# openbox is ready, and restarts itself if it crashes.
exec openbox --config-file "${OPENBOX_CONFIG:-/opt/jstarx/config/openbox/rc.xml}" \
  --startup "starx-shell-supervisor"
